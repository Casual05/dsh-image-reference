{
  "name": "dsh-image-reference",
  "version": "0.1.0",
  "description": "Reduce time to first token (TTFT) in image-heavy DeepSeek Harness chats with lightweight references for older images.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "image",
    "context",
    "ttft",
    "attachments"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Casual05/dsh-image-reference.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "DESIGN.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4",
    "@deepseek-ai/dsh-llm": ">=0.2.0-0 <0.3.0"
  }
}
